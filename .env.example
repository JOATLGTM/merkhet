# Supabase (Project Settings → API)
# Next.js loads `.env` and `.env.local`. Prefer `.env.local` for machine-local secrets.
# Do not commit either file with real keys.

NEXT_PUBLIC_SUPABASE_MERKET_URL=
NEXT_PUBLIC_SUPABASE_MERKET_ANON_KEY=

# Server-only. Prefer the legacy `service_role` JWT, or the new secret key (`sb_secret_…`).
# Needed for seeding and admin invite. Never expose to the browser.
SUPABASE_SERVICE_MERKET_ROLE_KEY=

# Origin invite emails link back to. Supabase composes those links on its own
# servers, so it cannot infer the host — it has to be told. Defaults to
# http://localhost:3000. Must match Site URL in the Supabase dashboard, and
# `<this>/accept-invite` must be listed under Auth → URL Configuration →
# Redirect URLs, or invites are rejected.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gmail send test (scripts/send-test-email.ts) — local harness only, not the app.
# GMAIL_TEST_APP_PASSWORD is a 16-character App Password, NOT the account password;
# create one at myaccount.google.com/apppasswords with 2-Step Verification enabled.
# Spaces in the App Password are stripped, so paste it however Google shows it.
GMAIL_TEST_USER=
GMAIL_TEST_APP_PASSWORD=
GMAIL_TEST_TO=
# Optional. Defaults to GMAIL_TEST_USER.
GMAIL_TEST_REPLY_TO=
