# Supabase (Project Settings → API)
# Next.js loads `.env` and `.env.local`. Prefer `.env.local` for machine-local secrets.
# Do not commit either file with real keys.

NEXT_PUBLIC_SUPABASE_MERKET_URL=
NEXT_PUBLIC_SUPABASE_MERKET_ANON_KEY=

# Server-only. Prefer the legacy `service_role` JWT, or the new secret key (`sb_secret_…`).
# Needed for seeding and admin invite. Never expose to the browser.
SUPABASE_SERVICE_MERKET_ROLE_KEY=

# Origin invite and password-reset emails link back to. Supabase composes those
# links on its own servers, so it cannot infer the host — it has to be told.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL then VERCEL_URL,
# and only then to http://localhost:3000; set it explicitly anyway.
#
# It must match Site URL in the Supabase dashboard, and `<this>/accept-invite`
# and `<this>/reset-password` must be listed under Auth → URL Configuration →
# Redirect URLs. An unlisted target does not error — Supabase silently sends
# the recipient to Site URL instead, which is how these end up on localhost.
#
# Set this to the deployed origin even for local development. A real invite sent
# from `npm run dev` would otherwise mail a link only that machine can open, and
# there is no case where that is what you wanted.
NEXT_PUBLIC_SITE_URL=https://merkhetdrafting.com

# Transactional email (lib/email/send.ts). Without RESEND_API_KEY messages are
# still written to the email_outbox table, just left `pending` — set the key and
# run `npm run email:retry` to flush them.
RESEND_API_KEY=
EMAIL_FROM="Merkhet <noreply@merkhetdrafting.com>"

# Customer-facing mail is rendered and recorded but NOT delivered unless this is
# exactly "true". Phase changes reach real clients — turn it on deliberately.
EMAIL_CUSTOMER_ENABLED=false

# Origin used for deep links inside internal email. Separate from
# NEXT_PUBLIC_SITE_URL (auth links); both should point at the deployed app.
NEXT_PUBLIC_APP_URL=https://merkhetdrafting.com

# Gmail send test (scripts/send-test-email.ts) — local harness only, not the app.
# GMAIL_TEST_APP_PASSWORD is a 16-character App Password, NOT the account password;
# create one at myaccount.google.com/apppasswords with 2-Step Verification enabled.
# Spaces in the App Password are stripped, so paste it however Google shows it.
GMAIL_TEST_USER=
GMAIL_TEST_APP_PASSWORD=
GMAIL_TEST_TO=
# Optional. Defaults to GMAIL_TEST_USER.
GMAIL_TEST_REPLY_TO=
